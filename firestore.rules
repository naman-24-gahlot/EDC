rules_version = '2';

// Deny ALL client access to every collection. The app never uses the client Firestore
// SDK: every read and write happens server-side in a Route Handler via the Admin SDK
// (which bypasses rules). These rules are defence in depth only — see SECURITY_MODEL.md.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
